# Copy this file to .env. Never expose these values to browser code or commit them.
# Existing meeting-summary node URL from the previous project.
JIMO_API_URL=https://jimoai-bot-api.xiaohuodui.cn/v2/chat/completions/share?shareId=UeuTh6Wu6TtQzQaS
# Full original Authorization value; do not add a Bearer/Basic prefix.
JIMO_AUTHORIZATION=replace-with-server-side-authorization
# Separate todo node URL, same Authorization as the summary node.
JIMO_TODO_API_URL=https://jimoai-bot-api.xiaohuodui.cn/v2/chat/completions/share?shareId=jSBaVou1SZDrd4bX

JIMO_MAX_REQUEST_CHARS=12000
JIMO_TRANSCRIPT_CHARS=5000
JIMO_STATE_CHARS=4000
JIMO_TIMEOUT_SECONDS=180
JIMO_CONNECT_TIMEOUT_SECONDS=20
JIMO_MAX_RETRIES=3

MEETING_HOST=127.0.0.1
MEETING_PORT=8765
MEETING_API_TOKEN=
MEETING_DEVICE=auto
MEETING_ASR_PRIMARY=Qwen/Qwen3-ASR-1.7B
# 识别、语言确认和冲突重识别统一使用一个 1.7B；旧字段仅保留协议兼容
MEETING_SINGLE_ASR_MODEL=1
MEETING_ASR_FALLBACK=Qwen/Qwen3-ASR-1.7B
MEETING_ASR_LANGUAGE_ID=Qwen/Qwen3-ASR-1.7B
# 后端流水线开关；WebSocket 协议不变
MEETING_RECOGNITION_ARCHITECTURE=single_1_7b_no_lid
MEETING_ASR_AUTODOWNLOAD=1
MEETING_VAD=fsmn-vad
MEETING_TRANSLATION_MODEL_ROOT=models/opus-mt
MEETING_TRANSLATION_AUTODOWNLOAD=0
MEETING_TRANSLATION_WARMUP=1
MEETING_RESULTS_DIR=result/meetings

MEETING_AUDIO_SEGMENT_MINUTES=30
MEETING_MAX_UTTERANCE_SECONDS=12
MEETING_AUDIO_PRE_ROLL_MS=500
MEETING_SPEECH_START_MS=80
MEETING_SILENCE_MS=950
MEETING_VAD_MINIMUM_RMS=109.23
MEETING_VAD_MINIMUM_SPEECH_MS=200
MEETING_VAD_MINIMUM_SPEECH_RATIO=0.06
MEETING_PARTIAL_INTERVAL_MS=1000
MEETING_LANGUAGE_ID_MIN_SECONDS=1.0
MEETING_LANGUAGE_CONFLICT_CONFIRMATIONS=3
MEETING_LANGUAGE_ID_ON_SEGMENT=1
MEETING_LANGUAGE_ID_ON_CONFLICT=1
MEETING_LANGUAGE_SWITCH_WINDOW_MS=800
MEETING_LANGUAGE_SWITCH_MAX_WAIT_MS=1800
MEETING_STABLE_PREFIX_MIN_CHARS=8
MEETING_MAX_AUDIO_PACKET_BYTES=262144
MEETING_MAX_RECORDING_SECONDS=14400
MEETING_AUDIO_INGEST_BURST_SECONDS=5
MEETING_INFERENCE_QUEUE_SIZE=64
MEETING_TRANSLATION_QUEUE_SIZE=64
# 0 可回退到兼容的 FIFO 队列；默认 1 启用后端分阶段流水线
MEETING_REALTIME_PIPELINE=1
MEETING_AUDIO_DRAIN_TIMEOUT_SECONDS=3
MEETING_ASR_TIMEOUT_SECONDS=45
MEETING_TRANSLATION_TIMEOUT_SECONDS=90
MEETING_TRANSLATION_DEADLINE_SECONDS=4.5
MEETING_TRANSLATION_PARTIAL_DEBOUNCE_MS=250
# 自动会后本地复译关闭；需要更高质量时由外部翻译智能体显式处理
MEETING_POST_TRANSLATION_ENABLED=0
MEETING_POST_TRANSLATION_QUALITY_THRESHOLD=0.62
MEETING_POST_TRANSLATION_CONTEXT_PARAGRAPHS=2
MEETING_POST_TRANSLATION_CONTEXT_CHARS=240
MEETING_POST_TRANSLATION_TIMEOUT_SECONDS=180
MEETING_QUEUE_JOIN_TIMEOUT_SECONDS=120
MEETING_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
MEETING_MAX_ACTIVE_MEETINGS=1
MEETING_STREAM_TICKET_TTL_SECONDS=60
MEETING_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
MEETING_WEBSOCKET_DISCONNECT_GRACE_SECONDS=15
MEETING_RETENTION_DAYS=30
MEETING_KEEP_AUDIO=1
JIMO_MAX_RESPONSE_CHARS=80000
