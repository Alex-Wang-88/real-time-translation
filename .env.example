# Copy this file to .env. Never expose these values to browser code or commit them.
JIMO_API_URL=https://jimoai-bot-api.xiaohuodui.cn/v2/chat/completions/share?shareId=replace-me
JIMO_AUTHORIZATION=
JIMO_MAX_REQUEST_CHARS=12000
JIMO_TRANSCRIPT_CHARS=6000
JIMO_STATE_CHARS=4000

MEETING_HOST=127.0.0.1
MEETING_PORT=8765
# Required when MEETING_HOST is not loopback. Open the Web UI as
# http://host:port/?token=the-same-value when using the browser client.
MEETING_API_TOKEN=
MEETING_DEVICE=auto
MEETING_ASR_MODEL=large-v3-turbo
MEETING_TRANSLATION_MODEL=JustFrederik/nllb-200-distilled-1.3B-ct2-int8
MEETING_RESULTS_DIR=result/live
MEETING_AUDIO_SEGMENT_MINUTES=30
MEETING_MAX_UTTERANCE_SECONDS=5
MEETING_DISK_WARN_BYTES=2147483648
MEETING_DISK_STOP_BYTES=536870912
MEETING_MAX_AUDIO_PACKET_BYTES=262144
MEETING_INFERENCE_QUEUE_SIZE=64
