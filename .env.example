# Copy this file to .env. Never expose these values to browser code or commit them.
# Existing meeting-summary node URL from the previous project.
JIMO_API_URL=https://jimoai-bot-api.xiaohuodui.cn/v2/chat/completions/share?shareId=UeuTh6Wu6TtQzQaS
# Full original Authorization value; do not add a Bearer/Basic prefix.
JIMO_AUTHORIZATION=replace-with-server-side-authorization
# Separate todo node URL, same Authorization as the summary node.
JIMO_TODO_API_URL=https://jimoai-bot-api.xiaohuodui.cn/v2/chat/completions/share?shareId=jSBaVou1SZDrd4bX

JIMO_MAX_REQUEST_CHARS=12000
JIMO_TRANSCRIPT_CHARS=5000
JIMO_STATE_CHARS=4000
JIMO_TIMEOUT_SECONDS=180
JIMO_CONNECT_TIMEOUT_SECONDS=20
JIMO_MAX_RETRIES=3

MEETING_HOST=127.0.0.1
MEETING_PORT=8765
MEETING_API_TOKEN=
MEETING_DEVICE=auto
MEETING_ASR_REALTIME=large-v3-turbo
MEETING_ASR_PRIMARY=large-v3-turbo
MEETING_ASR_FALLBACK=large-v3-turbo
MEETING_ASR_REFINE=large-v3
# Decoding quality controls. Higher beam values improve difficult audio but increase latency.
MEETING_ASR_REALTIME_BEAM_SIZE=5
MEETING_ASR_REFINE_BEAM_SIZE=6
MEETING_ASR_BEST_OF=5
MEETING_ASR_RETRY_TEMPERATURE=0.2
MEETING_ASR_LOG_PROB_THRESHOLD=-1.0
MEETING_ASR_NO_SPEECH_THRESHOLD=0.6
MEETING_ASR_COMPRESSION_RATIO_THRESHOLD=2.4
MEETING_ASR_AUTODOWNLOAD=1
MEETING_ENABLE_REFINEMENT=1
MEETING_ENABLE_POSTPROCESS=1
MEETING_VAD=fsmn-vad
MEETING_TRANSLATION_MODEL_ROOT=models/opus-mt
MEETING_TRANSLATION_AUTODOWNLOAD=1
MEETING_DIARIZATION_REQUIRED=1
MEETING_RESULTS_DIR=result/meetings

MEETING_AUDIO_SEGMENT_MINUTES=30
MEETING_MAX_UTTERANCE_SECONDS=8
MEETING_AUDIO_PRE_ROLL_MS=240
MEETING_SPEECH_START_MS=80
MEETING_SILENCE_MS=700
MEETING_VAD_MINIMUM_RMS=240
MEETING_VAD_MINIMUM_SPEECH_MS=450
MEETING_VAD_MINIMUM_SPEECH_RATIO=0.12
MEETING_PARTIAL_INTERVAL_MS=900
MEETING_MAX_AUDIO_PACKET_BYTES=262144
MEETING_MAX_RECORDING_SECONDS=14400
MEETING_AUDIO_INGEST_BURST_SECONDS=5
MEETING_INFERENCE_QUEUE_SIZE=64
MEETING_REFINEMENT_QUEUE_SIZE=16
MEETING_MAX_ACTIVE_MEETINGS=1
MEETING_STREAM_TICKET_TTL_SECONDS=60
MEETING_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5
MEETING_WEBSOCKET_DISCONNECT_GRACE_SECONDS=15
MEETING_RETENTION_DAYS=30
MEETING_KEEP_AUDIO=1
JIMO_MAX_RESPONSE_CHARS=80000
