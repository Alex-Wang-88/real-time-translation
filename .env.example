# Copy this file to .env. Never expose these values to browser code or commit them.
JIMO_API_URL=https://jimoai-bot-api.xiaohuodui.cn/v2/chat/completions/share?shareId=replace-me
JIMO_AUTHORIZATION=
JIMO_MAX_REQUEST_CHARS=12000
JIMO_TRANSCRIPT_CHARS=6000
JIMO_STATE_CHARS=4000

MEETING_HOST=127.0.0.1
MEETING_PORT=8765
# Required when MEETING_HOST is not loopback. The browser exchanges this API
# credential for a short-lived, one-use WebSocket stream ticket.
MEETING_API_TOKEN=
MEETING_DEVICE=auto
# Canonical names; the older *_MODEL names remain accepted for rollback.
MEETING_ASR_PRIMARY=FunAudioLLM/Fun-ASR-Nano-2512
MEETING_ASR_FALLBACK=large-v3-turbo
MEETING_ASR_REFINE=large-v3
MEETING_VAD=fsmn-vad
MEETING_TRANSLATION_TARGET=zh-CN
MEETING_ASR_MODEL=FunAudioLLM/Fun-ASR-Nano-2512
MEETING_ASR_FALLBACK_MODEL=large-v3-turbo
MEETING_REFINE_ASR_MODEL=large-v3
MEETING_ENABLE_REFINEMENT=1
MEETING_VAD_MODEL=fsmn-vad
MEETING_TRANSLATION_PROFILE=opusmt-local
MEETING_TRANSLATION_MODEL=opusmt-local
# Put audited CTranslate2 OPUS-MT pair directories under this directory.
MEETING_TRANSLATION_MODEL_ROOT=models/opus-mt
MEETING_TRANSLATION_AUTODOWNLOAD=0
MEETING_RESULTS_DIR=result/live
MEETING_AUDIO_SEGMENT_MINUTES=30
MEETING_MAX_UTTERANCE_SECONDS=8
MEETING_AUDIO_PRE_ROLL_MS=240
MEETING_SPEECH_START_MS=80
MEETING_SILENCE_MS=350
MEETING_PARTIAL_INTERVAL_MS=900
MEETING_DISK_WARN_BYTES=2147483648
MEETING_DISK_STOP_BYTES=536870912
MEETING_MAX_AUDIO_PACKET_BYTES=262144
MEETING_INFERENCE_QUEUE_SIZE=64
MEETING_REFINEMENT_QUEUE_SIZE=16
MEETING_FAST_INFERENCE_WORKERS=1
MEETING_REFINE_INFERENCE_WORKERS=1
MEETING_GPU_WORKERS=1
MEETING_GPU_MEMORY_BUDGET_MB=7200
MEETING_INFERENCE_WAIT_TIMEOUT_SECONDS=30
MEETING_MAX_CONCURRENT_MEETINGS=1
MEETING_MAX_PENDING_REFINEMENTS=10000
MEETING_MAX_REFINEMENT_SPOOL_BYTES=21474836480
MEETING_REFINEMENT_MAX_ATTEMPTS=3
MEETING_STREAM_TICKET_TTL_SECONDS=60
MEETING_WEBSOCKET_AUTH_TIMEOUT_SECONDS=5

# Enterprise gateway authentication. Enable only behind a trusted reverse proxy.
MEETING_TRUSTED_PROXY_AUTH=0
MEETING_TRUSTED_PROXY_SERVICE_TOKEN=
MEETING_TRUSTED_PROXY_USER_HEADER=x-meeting-user
MEETING_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
